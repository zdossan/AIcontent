# @BotFather-тен алынған токен
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# --- Arzan Pay (Kaspi) ---
# pay.arzan.cloud кабинетінен: Developer -> API Keys
ARZAN_API_KEY=ak_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# true болса нақты ақша алынбайды (тест үшін).
# Нақты сатуды бастағанда false қойыңыз.
ARZAN_SANDBOX=true

# --- Админдер, бос орынмен бөлінеді ---
# /stats, /export, /жаңа командаларын тек солар көреді
ADMIN_IDS=913413251

# --- Дерекқор ---
# Сериалдар, бөлімдер және төлемдер осы файлда сақталады
DB_PATH=aicontent.db

# --- Google кесте (тірі есеп, міндетті емес) ---
# Бос болса бот кестесіз жұмыс істей береді
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_FILE=/opt/aicontent-bot/google-credentials.json
